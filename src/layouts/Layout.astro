        function initMobileMenu() {
            const navToggle = document.getElementById('navToggle');
            const navLinksContainer = document.getElementById('navLinks');
            if (!navToggle || !navLinksContainer) return;

            function updateNavDomPosition() {
                if (window.innerWidth <= 768) {
                    document.body.appendChild(navLinksContainer!);
                } else {
                    const navInner = document.querySelector('.nav-inner');
                    if (navInner && !navInner.contains(navLinksContainer)) {
                        const cta = navInner.querySelector('.nav-cta');
                        if (cta) navInner.insertBefore(navLinksContainer!, cta);
                        else navInner.appendChild(navLinksContainer!);
                    }
                }
            }

            const originalCta = document.querySelector('.nav-cta');
            if (originalCta && !navLinksContainer.querySelector('.mobile-nav-cta')) {
                const mobileCta = originalCta.cloneNode(true) as HTMLElement;
                mobileCta.classList.add('mobile-nav-cta');
                mobileCta.classList.remove('nav-cta');
                mobileCta.style.opacity = '0';
                navLinksContainer.appendChild(mobileCta);
            }

            updateNavDomPosition();
            window.addEventListener('resize', updateNavDomPosition);

            const links = navLinksContainer.querySelectorAll('a');
            navLinksContainer.querySelectorAll<HTMLElement>('a:not(.mobile-nav-cta)').forEach(link => {
                const block = document.createElement('div');
                block.className = 'reveal-block';
                link.appendChild(block);
            });

            let isMenuOpen = false;
            let menuTl = gsap.timeline({ paused: true });
            menuTl.to(links, { opacity: 1, duration: 0.2, stagger: 0.05 })
                  .to(navLinksContainer.querySelectorAll('.reveal-block'), {
                      scaleX: 0, transformOrigin: 'right', duration: 0.6, stagger: 0.1, ease: 'power3.inOut'
                  }, 0);

            navToggle.addEventListener('click', () => {
                isMenuOpen = !isMenuOpen;
                navToggle.classList.toggle('active');
                navLinksContainer.classList.toggle('open');
                if (isMenuOpen) {
                    setTimeout(() => menuTl.restart(), 300);
                } else {
                    menuTl.reverse();
                }
            });

            // Close mobile menu when any link is tapped
            navLinksContainer.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', () => {
                    if (isMenuOpen) {
                        isMenuOpen = false;
                        navToggle.classList.remove('active');
                        navLinksContainer.classList.remove('open');
                        menuTl.reverse();
                    }
                });
            });
        }

        // Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ INIT ALL Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬
        // â”€â”€â”€ PERSON POPUP â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        function initPersonPopup() {
            (window as any).__openPersonPopup = (name: string, role: string, img: string, desc: string) => {
                const popup = document.getElementById('personPopup');
                if (!popup) return;
                const popupName = document.getElementById('personPopupName');
                const popupRole = document.getElementById('personPopupRole');
                const popupPhoto = document.getElementById('personPopupPhoto') as HTMLImageElement;
                const popupPhotoPlaceholder = document.getElementById('personPopupPhotoPlaceholder');
                const popupDesc = document.getElementById('personPopupDesc');

                if (popupName) popupName.textContent = name;
                if (popupRole) popupRole.textContent = role;
                if (popupDesc) popupDesc.textContent = desc || "This member represents the pinnacle of leadership and dedication. Tasked with executing a flawless conference experience, their role involves coordinating with executive board members, overseeing committee dynamics, and ensuring academic rigor. With a strong background in public speaking and international relations, they are committed to fostering a supportive, challenging, and intellectually stimulating environment for all delegates at RBSMUN 2026.";
                if (popupPhoto && popupPhotoPlaceholder) {
                    popupPhoto.src = img;
                    popupPhoto.style.display = 'block';
                    (popupPhotoPlaceholder as HTMLElement).style.display = 'none';
                    popupPhoto.onerror = () => {
                        popupPhoto.style.display = 'none';
                        (popupPhotoPlaceholder as HTMLElement).style.display = 'flex';
                    };
                }
                popup.classList.add('active');
                if ((window as any).lenis) (window as any).lenis.stop();
            };

            const popup = document.getElementById('personPopup');
            const closeBtn = document.getElementById('personPopupClose');
            if (!popup) return;

            // Move popup to the very end of the body to guarantee it escapes any stacking contexts
            // or backdrop-filters that might trap its z-index behind other overlays.
            if (popup.parentElement !== document.body) {
                document.body.appendChild(popup);
            }
            if (!popup) return;

            function closePopup() {
                popup.classList.remove('active');
                if ((window as any).lenis) (window as any).lenis.start();
            }

            closeBtn?.addEventListener('click', closePopup);
            popup.addEventListener('click', e => { if (e.target === popup) closePopup(); });
            document.addEventListener('keydown', e => { if (e.key === 'Escape' && popup.classList.contains('active')) closePopup(); });
        }

        // â”€â”€â”€ INIT ALL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        function initAll() {
            // Initialize global loader fadeout on window load
            window.addEventListener('load', () => {
                const globalLoader = document.getElementById('global-loader');
                if (globalLoader) {
                    globalLoader.classList.add('hidden');
                    setTimeout(() => globalLoader.remove(), 600);
                }
            });

            initPreloader();
            initUniqueScrollAnimations();
            initNavScroll();
            initMobileMenu();
            initCountUp();
            initCardGlowTracking();
            initMagneticButtons();
            initHeroShrink();
            initCommitteeExpand();
            initTeamExpand();
            initPersonPopup();
            initPerformanceControls();
        }

        // ─── PERFORMANCE CONTROLS ───────────────────────────────────────────────
        function initPerformanceControls() {
            // EDIT THIS VARIABLE TO TOGGLE HIGH-FREQUENCY ANIMATIONS
            // Set to true to disable WebGL background, card glow tracking, and magnetic buttons.
            const DISABLE_HIGH_FREQ_ANIMATIONS = true;

            (window as any).disableCanvasAnimations = DISABLE_HIGH_FREQ_ANIMATIONS;
            (window as any).disableCardGlows = DISABLE_HIGH_FREQ_ANIMATIONS;

            // Dispatch canvas event in case component is already mounted
            window.dispatchEvent(new CustomEvent('perf-animations-toggle'));

            // Clean up properties if disabled
            if (DISABLE_HIGH_FREQ_ANIMATIONS) {
                document.querySelectorAll<HTMLElement>('.glass-card').forEach(card => {
                    card.style.removeProperty('--glow-x');
                    card.style.removeProperty('--glow-y');
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAll);
        } else {
            initAll();
        }
    </script>
</body>
</html>

