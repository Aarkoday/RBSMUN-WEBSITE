---
import Layout from "../layouts/Layout.astro";
import WebGLBackground from "../components/WebGLBackground.jsx";
import { REGISTRATION_URL } from "../data/site-config";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const committees = [
    {
        id: "jcc",
        acronym: "FJCC",
        fullname: "Futuristic Joint Crisis Committee",
    },
    { id: "disec", acronym: "DISEC", fullname: "DISEC" },
    { id: "ecofin", acronym: "ECOFIN", fullname: "ECOFIN" },
    { id: "icj", acronym: "ICJ", fullname: "ICJ" },
    { id: "irc", acronym: "IRC", fullname: "The Imperial Romanov Court" },
    { id: "who", acronym: "WHO", fullname: "WHO" },
    { id: "hor", acronym: "HoR", fullname: "प्रतिनिधि सभा" },
    {
        id: "gcmr",
        acronym: "GCMR",
        fullname: "The Grand Convocation of the Mythical Realms",
    },
    { id: "unsc", acronym: "UNSC", fullname: "UNSC" },
    {
        id: "picc",
        acronym: "PICC",
        fullname: "Paris International Conference on Cambodia",
    },
    { id: "unwomen", acronym: "UNWOMEN", fullname: "UNWOMEN" },
    { id: "hrc", acronym: "HRC", fullname: "HRC" },
    {
        id: "uscc",
        acronym: "USCC",
        fullname: "United States Congressional Committee (Senate)",
    },
    { id: "sochum", acronym: "SOCHUM", fullname: "SOCHUM" },
    { id: "ipc", acronym: "IPC", fullname: "IPC" },
];
---

<Layout title="Committees – RBSMUN 2026">
    <WebGLBackground client:only="react" />

    <nav class="glass-nav" id="mainNav">
        <div class="nav-inner">
            <a href={`${base}/`} class="nav-logo"
                ><img src={`${base}/images/logo.webp`} alt="RBSMUN Logo" /></a
            >
            <div class="nav-links" id="navLinks">
                <a href={`${base}/`}>Home</a>
                <a href={`${base}/about`}>About Us</a>
                <a href={`${base}/committees`} class="active">Committees</a>
                <a href={`${base}/conference`}>Conference Details</a>
                <a href={`${base}/team`}>Our Team</a>
            </div>
            {
                REGISTRATION_URL ? (
                    <a href={REGISTRATION_URL} target="_blank" class="nav-cta">
                        Register →
                    </a>
                ) : (
                    <button
                        class="nav-cta"
                        style="pointer-events: none; opacity: 0.75;"
                        tabindex="-1"
                    >
                        Coming Soon
                    </button>
                )
            }
            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    <section
        class="page-hero"
        style={`background-image: url('${base}/images/miscellaneous/committees.webp');`}
    >
        <div class="container">
            <h1 class="page-hero-title">Committees</h1>
            <p class="page-hero-subtitle">
                Engage in rigorous debate and draft resolutions across our
                specialized committees.
            </p>
        </div>
    </section>

    <div class="content-wrapper">
        <section class="section">
            <div class="container">
                <div class="committees-grid">
                    {
                        committees.map((c) => (
                            <a
                                href={`${base}/committees/${c.id}`}
                                class="committee-card-link"
                                aria-label={c.fullname}
                            >
                                <div
                                    class="glass-card committee-logo-card"
                                    data-anim="scatter"
                                    transition:name={`committee-title-${c.id}`}
                                >
                                    <div
                                        class="committee-overlay-bg"
                                        style={`background-image: url('${base}/images/committees/${c.id}/card-bg.webp');`}
                                    />
                                    <div class="card-glow" />
                                    <h2
                                        class="committee-massive-acronym"
                                        style={
                                            c.id === "hor"
                                                ? "font-family: 'Mukta', sans-serif; font-size: clamp(1.8rem, 3.8vw, 2.8rem); letter-spacing: normal; font-weight: 700;"
                                                : ""
                                        }
                                    >
                                        {c.id === "hor"
                                            ? c.fullname
                                            : c.acronym}
                                    </h2>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4 class="footer-logo">
                        RBS<span class="logo-accent">MUN</span>
                    </h4>
                </div>
                <div class="footer-col">
                    <h4>Navigate</h4>
                    <a href="/">Home</a>
                    <a href="/about">About Us</a>
                    <a href="/committees">Committees</a>
                    <a href="/conference">Conference Details</a>
                </div>
                <div class="footer-col">
                    <h4>Contact</h4>
                    <a href="mailto:contact@ratobangala.edu.np"
                        >contact@ratobangala.edu.np</a
                    >
                    <a href="tel:015447618">01-5447618</a>
                    <a href="tel:015447620">01-5447620</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 RBSMUN. All rights reserved.</p>
            </div>
        </div>
    </footer>
</Layout>
