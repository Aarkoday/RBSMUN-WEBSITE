---
import Layout from "../../layouts/Layout.astro";
import WebGLBackground from "../../components/WebGLBackground.jsx";
import {
    COMMITTEES,
    COMMITTEE_DAIS_DATA,
    DEFAULT_DAIS,
} from "../../data/committees";
import { REGISTRATION_URL } from "../../data/site-config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

export function getStaticPaths() {
    return COMMITTEES.map((c) => ({
        params: { committee: c.id },
        props: { committee: c },
    }));
}

const { committee } = Astro.props;
const daisMembers = COMMITTEE_DAIS_DATA[committee.id] || DEFAULT_DAIS;

const hasCabinets = daisMembers.some(m => m.cabinet);
let cabinets = [];
if (hasCabinets) {
    const cabMap = {};
    daisMembers.forEach(m => {
        const cabName = m.cabinet || "Executive Board";
        if (!cabMap[cabName]) {
            cabMap[cabName] = [];
        }
        cabMap[cabName].push(m);
    });
    cabinets = Object.entries(cabMap);
}
---

<Layout title={`${committee.id === 'hor' ? 'प्रतिनिधि सभा' : committee.acronym} – RBSMUN 2026`}>
    <WebGLBackground client:only="react" />

    <nav class="glass-nav" id="mainNav">
        <div class="nav-inner">
            <a href={`${base}/`} class="nav-logo"
                ><img src={`${base}/images/logo.webp`} alt="RBSMUN Logo" /></a
            >
            <div class="nav-links" id="navLinks">
                <a href={`${base}/`}>Home</a>
                <a href={`${base}/about`}>About Us</a>
                <a href={`${base}/committees`} class="active">Committees</a>
                <a href={`${base}/conference`}>Conference Details</a>
                <a href={`${base}/team`}>Our Team</a>
            </div>
            {REGISTRATION_URL ? (
            <a
                href={REGISTRATION_URL}
                target="_blank"
                class="nav-cta">Register →</a
            >
            ) : (
            <button
                class="nav-cta"
                style="pointer-events: none; opacity: 0.75;"
                tabindex="-1">Coming Soon</button>
            )}
            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    <div class="committee-detail-page" id="committeePageWrapper">
        <!-- Background logo with fade -->
        <div
            class="committee-overlay-bg"
            id="detailBg"
            style={`background-image: url('${base}/images/committees/${committee.id}/logo.webp');`}
        ></div>

        <!-- ── HEADER ────────────────────────────────────────────── -->
        <div class="committee-overlay-header committee-hero-layout">
            <h1
                class="committee-overlay-acronym committee-detail-visible"
                style={committee.id === 'hor' ? "font-family: 'Mukta', sans-serif; font-size: clamp(3rem, 7vw, 5.5rem); letter-spacing: normal; font-weight: 800;" : ""}
                transition:name={`committee-title-${committee.id}`}
            >
                {committee.id === 'hor' ? committee.fullname : committee.acronym}
            </h1>
            <p class="committee-overlay-fullname committee-detail-visible">
                {committee.id === 'hor' ? 'House of Representatives' : committee.fullname}
            </p>

            <!-- Dynamic single Agenda element -->
            <p class="committee-agenda-dynamic">
                {committee.agenda || "[Agenda to be announced]"}
            </p>

            <!-- Quick Info buttons (hidden initially, visible when scrolled) -->
            <div class="committee-overlay-quick-info committee-detail-visible">
                <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;">
                    <a 
                        href={committee.study_guide || "#"} 
                        target={committee.study_guide ? "_blank" : "_self"} 
                        class="btn btn-primary study-guide-btn" 
                        data-has-guide={committee.study_guide ? "true" : "false"}
                        style="padding: 0.75rem 1.5rem; font-size: 0.95rem;"
                    >
                        Study Guide
                    </a>
                    <span class="btn btn-glass" style="padding: 0.75rem 1.5rem; font-size: 0.95rem; cursor: default; pointer-events: none; opacity: 0.85;">
                        {committee.email || "committee@ratobangala.edu.np"}
                    </span>
                </div>
            </div>
        </div>

        <!-- ── BODY ─────────────────────────────────────────────── -->
        <div class="committee-overlay-body">
            <!-- Mandate -->
            <div class="committee-overlay-section committee-detail-visible">
                <p class="section-eyebrow">Information</p>
                <h2 class="section-title">
                    Committee <span class="text-gradient">Mandate</span>
                </h2>
                <div class="glass-card">
                    <div class="card-glow"></div>
                    {
                        committee.mandate ? (
                            <p set:html={committee.mandate} />
                        ) : (
                            <p style="opacity: 0.5;">
                                [Insert Committee Mandate here. Start by
                                establishing the context of the committee's
                                scope within the United Nations framework...]
                            </p>
                        )
                    }
                </div>
            </div>

            <!-- Executive Board -->
            <div class="committee-overlay-section committee-detail-visible">
                <p class="section-eyebrow">Leadership</p>
                <h2 class="section-title">
                    Executive <span class="text-gradient">Board</span>
                </h2>

                <!-- EB group photo (hidden gracefully if missing) -->
                <div
                    class="glass-card eb-group-card"
                    style="margin-bottom:2rem; overflow:hidden; padding:0;"
                >
                    <div class="card-glow"></div>
                    <div
                        style="width:100%; aspect-ratio:16/9; max-height:420px; display:flex; align-items:center; justify-content:center; overflow:hidden; background:rgba(255,255,255,0.02);"
                    >
                        <img
                            src={`${base}/images/committees/${committee.id}/eb-group.webp`}
                            alt="Executive Board Group Photo"
                            style={`width:100%; height:100%; object-fit:cover; object-position: ${committee.group_position || 'center'}; transform: scale(${committee.group_zoom || 1}); transform-origin: ${committee.group_position || 'center'};`}
                            onerror="this.closest('.glass-card').style.display='none';"
                        />
                    </div>
                </div>

                <!-- Individual EB cards -->
                {
                    hasCabinets ? (
                        cabinets.map(([cabName, members]) => {
                            return (
                                <div class="cabinet-section" style="margin-top: 3rem;">
                                    <h3 class="cabinet-title" style="font-family: var(--font-display); font-size: 1.5rem; margin-bottom: 1.5rem; text-align: center; color: var(--text-primary);">{cabName}</h3>
                                    
                                    <div class="team-grid">
                                        {members.map((m) => {
                                            const imgSrc = `${base}/images/committees/${committee.id}/${m.img}`;
                                            return (
                                                <div class="team-card-wrapper">
                                                    <div
                                                        class="glass-card team-card person-card"
                                                        data-person-name={m.name}
                                                        data-person-role={m.role}
                                                        data-person-img={imgSrc}
                                                        data-person-desc={m.desc || ""}
                                                        data-person-img-pos={m.img_position || ""}
                                                        data-person-img-zoom={m.img_zoom ? String(m.img_zoom) : ""}
                                                        style={`cursor:pointer;${m.card_position ? ` --card-position:${m.card_position};` : ''}${m.card_zoom ? ` --card-zoom:${m.card_zoom};` : ''}`}
                                                    >
                                                        <img
                                                            src={imgSrc}
                                                            alt={m.name}
                                                            class="team-img-bg"
                                                            onerror="this.style.display='none'"
                                                        />
                                                        <div class="team-card-overlay" />
                                                        <div class="team-card-content">
                                                            <h3>{m.name}</h3>
                                                            <p class="team-role">{m.role}</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            );
                                        })}
                                    </div>
                                </div>
                            );
                        })
                    ) : (
                        <div class="team-grid" id="ebMembersGrid">
                            {
                                daisMembers.map((m) => {
                                    const imgSrc = `${base}/images/committees/${committee.id}/${m.img}`;
                                    return (
                                        <div class="team-card-wrapper">
                                            <div
                                                class="glass-card team-card person-card"
                                                data-person-name={m.name}
                                                data-person-role={m.role}
                                                data-person-img={imgSrc}
                                                data-person-desc={m.desc || ""}
                                                data-person-img-pos={m.img_position || ""}
                                                data-person-img-zoom={m.img_zoom ? String(m.img_zoom) : ""}
                                                style={`cursor:pointer;${m.card_position ? ` --card-position:${m.card_position};` : ''}${m.card_zoom ? ` --card-zoom:${m.card_zoom};` : ''}`}
                                            >
                                                <img
                                                    src={imgSrc}
                                                    alt={m.name}
                                                    class="team-img-bg"
                                                    onerror="this.style.display='none'"
                                                />
                                                <div class="team-card-overlay" />
                                                <div class="team-card-content">
                                                    <h3>{m.name}</h3>
                                                    <p class="team-role">{m.role}</p>
                                                </div>
                                            </div>
                                        </div>
                                    );
                                })
                            }
                        </div>
                    )
                }
            </div>

        </div>
    </div>

    <!-- Person Detail Popup -->
    <div class="person-popup" id="personPopup">
        <div class="person-popup-inner" data-lenis-prevent>
            <button
                class="person-popup-close"
                id="personPopupClose"
                aria-label="Close">&times;</button
            >
            <div class="person-popup-left">
                <div class="person-popup-photo-wrap">
                    <img
                        class="person-popup-photo"
                        id="personPopupPhoto"
                        src=""
                        alt="Person photo"
                    />
                    <div
                        class="person-popup-photo-placeholder"
                        id="personPopupPhotoPlaceholder"
                    >
                        <span>👤</span>
                    </div>
                </div>
                <div class="person-popup-meta">
                    <h2 class="person-popup-name" id="personPopupName"></h2>
                    <p class="person-popup-role" id="personPopupRole"></p>
                </div>
            </div>
            <div class="person-popup-right" data-lenis-prevent>
                <p class="person-popup-desc" id="personPopupDesc"></p>
            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4 class="footer-logo">
                        RBS<span class="logo-accent">MUN</span>
                    </h4>
                </div>
                <div class="footer-col">
                    <h4>Navigate</h4>
                    <a href="/">Home</a>
                    <a href="/about">About Us</a>
                    <a href="/committees">Committees</a>
                    <a href="/conference">Conference Details</a>
                </div>
                <div class="footer-col">
                    <h4>Contact</h4>
                    <a href="mailto:contact@ratobangala.edu.np"
                        >contact@ratobangala.edu.np</a
                    >
                    <a href="tel:015447618">01-5447618</a>
                    <a href="tel:015447620">01-5447620</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 RBSMUN. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        function bindPersonCards() {
            document
                .querySelectorAll<HTMLElement>(".person-card[data-person-name]")
                .forEach((card) => {
                    // Avoid duplicate listeners
                    if ((card as any).__popupBound) return;
                    (card as any).__popupBound = true;
                    card.addEventListener("click", () => {
                        const name = card.dataset.personName || "";
                        const role = card.dataset.personRole || "";
                        const img = card.dataset.personImg || "";
                        const desc = card.dataset.personDesc || "";
                        const imgPos = card.dataset.personImgPos || "";
                        const imgZoom = card.dataset.personImgZoom || "";
                        if ((window as any).__openPersonPopup) {
                            (window as any).__openPersonPopup(name, role, img, desc, imgPos, imgZoom);
                        }
                    });
                });
        }
        // Runs on first load AND after every View Transition
        document.addEventListener("astro:page-load", bindPersonCards);

        function initStudyGuideBtn() {
            document.querySelectorAll(".study-guide-btn").forEach(btn => {
                if (btn.getAttribute("data-has-guide") === "false") {
                    if ((btn as any).__guideBound) return;
                    (btn as any).__guideBound = true;
                    
                    let timeout: any = null;
                    btn.addEventListener("click", (e) => {
                        e.preventDefault();
                        if (btn.textContent?.trim() === "Coming Soon") return;
                        
                        btn.textContent = "Coming Soon";
                        
                        if (timeout) clearTimeout(timeout);
                        timeout = setTimeout(() => {
                            btn.textContent = "Study Guide";
                        }, 5000);
                    });
                }
            });
        }
        document.addEventListener("astro:page-load", initStudyGuideBtn);

        // Scroll listener for hero fade effect
        document.addEventListener("astro:page-load", () => {
            const handleScroll = () => {
                if (window.scrollY > 50) {
                    document.body.classList.add("is-scrolled");
                } else {
                    document.body.classList.remove("is-scrolled");
                }
            };
            
            window.addEventListener("scroll", handleScroll);
            handleScroll(); // init
            
            // Cleanup on page leave (important for View Transitions)
            document.addEventListener("astro:before-swap", () => {
                window.removeEventListener("scroll", handleScroll);
                document.body.classList.remove("is-scrolled");
            }, { once: true });
        });
    </script>

    <style>
        /* Initial logo state: lighter opacity but still has the mask */
        :global(body:not(.is-scrolled)) .committee-overlay-bg {
            opacity: 0.4 !important; /* Lighter than 0.15, keeps the gradient fade mask */
            transition: opacity 0.5s ease;
        }

        :global(body.is-scrolled) .committee-overlay-bg {
            opacity: 0.15 !important;
            transition: opacity 0.5s ease;
        }

        .committee-agenda-dynamic {
            font-family: var(--font-display);
            font-size: 1.6rem;
            font-weight: bold;
            text-align: center;
            max-width: 800px;
            line-height: 1.4;
            margin-top: 1.5rem;
            opacity: 1;
            transition: font-size 0.5s ease, font-weight 0.5s ease, opacity 0.5s ease, margin-top 0.5s ease;
        }

        :global(body.is-scrolled) .committee-agenda-dynamic {
            font-size: 1.2rem;
            font-weight: normal;
            opacity: 0.9;
            margin-top: 1rem;
        }

        /* Hide quick info initially, fade in on scroll */
        .committee-overlay-quick-info {
            opacity: 0;
            visibility: hidden;
            transform: translateY(15px);
            pointer-events: none;
            transition: opacity 0.5s ease, transform 0.5s ease, visibility 0.5s ease;
            margin-top: 1.5rem;
        }

        :global(body.is-scrolled) .committee-overlay-quick-info {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            pointer-events: auto;
        }

        .committee-hero-layout {
            min-height: calc(100vh - 80px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
            padding-bottom: 4rem !important;
        }
        
        /* Make the back link stay at the top */
        .committee-hero-layout .committee-back-link {
            margin-top: 1rem;
        }
    </style>
</Layout>
