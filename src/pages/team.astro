---
import Layout from "../layouts/Layout.astro";
import WebGLBackground from "../components/WebGLBackground.jsx";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const teams = [
    { id: "logistics",   title: "Logistics",              img: "team-group.webp" },
    { id: "secretariat", title: "Secretariat",            img: "team-group.webp" },
    { id: "it",          title: "Information Technology", img: "team-group.webp" },
    { id: "art",         title: "Art & Design",           img: "team-group.webp" },
    { id: "media",       title: "Media & Communications", img: "team-group.webp" },
    { id: "photography", title: "Photography",            img: "team-group.webp" },
];
---

<Layout title="Our Team – RBSMUN 2026">
    <WebGLBackground client:only="react" />

    <nav class="glass-nav" id="mainNav">
        <div class="nav-inner">
            <a href={`${base}/`} class="nav-logo"
                ><img src={`${base}/images/logo.webp`} alt="RBSMUN Logo" /></a
            >
            <div class="nav-links" id="navLinks">
                <a href={`${base}/`}>Home</a>
                <a href={`${base}/about`}>About Us</a>
                <a href={`${base}/committees`}>Committees</a>
                <a href={`${base}/conference`}>Conference Details</a>
                <a href={`${base}/team`} class="active">Our Team</a>
            </div>
            <a
                href="https://docs.google.com/forms/d/e/1FAIpQLScHRl-Q3-XBSMNHwiufUyGBYGU-MBBVO2-GGSOJL0atyxPcKg/viewform"
                target="_blank"
                class="nav-cta">Register →</a
            >
            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    <section
        class="page-hero"
        style={`background-image: url('${base}/images/miscellaneous/RBS+MUN+Posts+Bg.webp');`}
    >
        <div class="hero-bg-overlay"></div>
        <div class="container">
            <h1 class="page-hero-title">Our Team</h1>
            <p class="page-hero-subtitle">
                The dedicated minds working tirelessly to bring you the 21st
                iteration of RBSMUN.
            </p>
        </div>
    </section>

    <div class="content-wrapper">
        <section class="section">
            <div class="container">
                <div class="team-grid">
                    {teams.map((t, i) => (
                        <div class="team-card-wrapper">
                            <a
                                href={`${base}/team/${t.id}`}
                                class="team-card-link"
                                aria-label={t.title}
                            >
                                <div
                                    class="glass-card team-card"
                                    data-anim="tilt-in"
                                    data-delay={String(i * 100)}
                                    transition:name={`team-title-${t.id}`}
                                >
                                    <img
                                        src={`${base}/images/team/${t.id}/${t.img}`}
                                        alt={t.title}
                                        class="team-img-bg"
                                        onerror="this.style.display='none'"
                                    />
                                    <div class="team-card-overlay"></div>
                                    <div class="team-card-content">
                                        <h3>{t.title}</h3>
                                    </div>
                                </div>
                            </a>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4 class="footer-logo">
                        RBS<span class="logo-accent">MUN</span>
                    </h4>
                </div>
                <div class="footer-col">
                    <h4>Navigate</h4>
                    <a href="/">Home</a>
                    <a href="/about">About Us</a>
                    <a href="/committees">Committees</a>
                    <a href="/conference">Conference Details</a>
                </div>
                <div class="footer-col">
                    <h4>Contact</h4>
                    <a href="mailto:contact@ratobangala.edu.np"
                        >contact@ratobangala.edu.np</a
                    >
                    <a href="tel:015447618">01-5447618</a>
                    <a href="tel:015447620">01-5447620</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 RBSMUN. All rights reserved.</p>
            </div>
        </div>
    </footer>
</Layout>
