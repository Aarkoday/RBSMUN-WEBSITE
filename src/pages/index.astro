---
import Layout from '../layouts/Layout.astro';
import WebGLBackground from '../components/WebGLBackground.jsx';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="RBSMUN 2026 — Rato Bangala School Model United Nations">

    <WebGLBackground client:only="react" />

    <nav class="glass-nav" id="mainNav" style="opacity: 0; clip-path: circle(0% at 50% 0%); -webkit-clip-path: circle(0% at 50% 0%);">
        <div class="nav-inner">
            <a href={`${base}/`} class="nav-logo"><img src={`${base}/images/logo.webp`} alt="RBSMUN Logo"></a>
            <div class="nav-links" id="navLinks">
                <a href={`${base}/`} class="active">Home</a>
                <a href={`${base}/about`}>About Us</a>
                <a href={`${base}/committees`}>Committees</a>
                <a href={`${base}/conference`}>Conference Details</a>
                <a href={`${base}/team`}>Our Team</a>
            </div>
            <a href="https://docs.google.com/forms/d/e/1FAIpQLScHRl-Q3-XBSMNHwiufUyGBYGU-MBBVO2-GGSOJL0atyxPcKg/viewform"
                target="_blank" class="nav-cta">Register →</a>
            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    <section class="hero" id="hero">
        <div class="hero-bg-overlay"></div>
        <div class="hero-mesh"></div>
        <div class="hero-glass-panel hero-glass-1"></div>
        <div class="hero-glass-panel hero-glass-2"></div>
        <div class="hero-glass-panel hero-glass-3"></div>
        <div class="hero-preloader-white" id="hero-white-overlay"></div>
        <div class="hero-content">
            <h1 class="hero-title">
                <span class="title-line">RBSMUN</span>
                <span class="title-line title-outline">2026</span>
            </h1>
        </div>
    </section>

    <section class="stats-section" id="stats">
        <div class="stats-glass-bar">
            <div class="container">
                <div class="stats-grid">
                    <div class="stat-item" data-anim="counter" id="stat1">
                        <span class="stat-number" data-target="21">0</span>
                        <span class="stat-label">Iterations</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item" data-anim="counter" id="stat2">
                        <span class="stat-number" data-target="500">0</span>
                        <span class="stat-suffix">+</span>
                        <span class="stat-label">Delegates Annually</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item" data-anim="counter" id="stat3">
                        <span class="stat-number" data-target="20">0</span>
                        <span class="stat-suffix">+</span>
                        <span class="stat-label">Years of Legacy</span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-item" data-anim="counter" id="stat4">
                        <span class="stat-number" data-target="15">0</span>
                        <span class="stat-label">Committees</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="about">
        <div class="container">
            <div class="about-editorial" data-anim="fade-up">
                <div class="about-editorial-left">
                    <div class="about-year-counter">
                        <span class="about-big-number" data-target="21">0</span>
                        <span class="about-big-label">iterations</span>
                    </div>
                    <div class="about-year-line"></div>
                    <p class="about-year-since">Est. 2005</p>
                </div>
                <div class="about-editorial-right">
                    <p class="section-eyebrow">About RBSMUN</p>
                    <h2 class="section-title" style="text-align:left; margin-bottom: 1.5rem;">Nepal's <span
                            class="text-gradient">Most Prestigious</span><br>Student-Run Conference</h2>
                    <div class="about-editorial-body">
                        <p>As one of the first Model United Nations conferences in the country, RBSMUN has spent two
                            decades building a space where students transform into diplomats.</p>
                        <p>Hosted entirely by students of RBS, the conference draws delegates from across Nepal to
                            debate, negotiate, and draft solutions to the world's most pressing challenges.</p>
                        <p>This year's theme — <em>Conflict Prevention &amp; Peace</em> — confronts an increasingly
                            polarised world head-on, exploring the structures that hold societies together and the
                            fractures that tear them apart.</p>
                    </div>
                    <div style="margin-top: 2.5rem;">
                        <a href="/about" class="btn btn-glass">Read our full history →</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section section-textured" id="letter">
        <div class="container">
            <div class="section-header" data-anim="reveal">
                <p class="section-eyebrow">A Message</p>
                <h2 class="section-title">From the <span class="text-gradient">Secretary General</span></h2>
            </div>
            <div class="letter-layout" data-anim="morph-in">
                <div class="glass-card letter-card">
                    <div class="letter-accent-line"></div>
                    <p class="letter-greeting">Dearest Delegates and Faculty Advisors,</p>
                    <p class="letter-text">It is with great pride and honour that I welcome you all to the Rato Bangala
                        School Model United Nations conference. Since its inception in 2005, RBSMUN has strived to
                        create an environment that facilitates stimulating exchanges coupled with the drive to bring
                        forth change.</p>
                    <p class="letter-text">A pioneer of MUN culture in Nepal, this student-run conference fosters vital
                        skills that reach far beyond the boundaries of international relations, preparing delegates for
                        the highs and lows in various facets of life.</p>
                    <p class="letter-text">By bringing together some of the most promising students from across the
                        region to emerge as better leaders, we hope to make this RBSMUN a transformative experience —
                        one that delegates will carry with them for the rest of their lives.</p>
                    <div class="letter-signature">
                        <div class="signature-line"></div>
                        <p class="signature-name">The Secretary-General</p>
                        <p class="signature-title">RBSMUN 2026</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section cta-section" id="register">
        <div class="cta-glass-backdrop"></div>
        <div class="container">
            <div class="cta-content" data-anim="morph-in">
                <div class="cta-glass-card glass-card">
                    <h2 class="cta-title">Ready to Shape<br>the <span class="text-gradient">Future</span>?</h2>
                    <p class="cta-subtitle">Join over 500 delegates in one of Nepal's most prestigious MUN conferences.
                    </p>
                    <a href="https://docs.google.com/forms/d/e/1FAIpQLScHRl-Q3-XBSMNHwiufUyGBYGU-MBBVO2-GGSOJL0atyxPcKg/viewform"
                        target="_blank" class="btn btn-primary btn-lg">
                        <span>Register for RBSMUN 2026</span>
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5"
                                stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4 class="footer-logo">RBS<span class="logo-accent">MUN</span></h4>
                    
                </div>
                <div class="footer-col">
                    <h4>Navigate</h4>
                    <a href="/">Home</a>
                    <a href="/about">About Us</a>
                    <a href="/committees">Committees</a>
                    <a href="/conference">Conference Details</a>
                </div>
                <div class="footer-col">
                    <h4>Contact</h4>
                    <a href="mailto:contact@ratobangala.edu.np">contact@ratobangala.edu.np</a>
                    <a href="tel:015447618">01-5447618</a>
                    <a href="tel:015447620">01-5447620</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 RBSMUN. All rights reserved.</p>
            </div>
        </div>
    </footer>

</Layout>
