                                >
                                    <span>Coming Soon</span>
                                </button>
                            )
                        }
                    </div>
                </div>
            </div>
        </section>

        <footer class="footer">
            <div class="container">
                <div class="footer-grid">
                    <div class="footer-col">
                        <h4 class="footer-logo">
                            RBS<span class="logo-accent">MUN</span>
                        </h4>
                    </div>
                    <div class="footer-col">
                        <h4>Navigate</h4>
                        <a href="/">Home</a>
                        <a href="/about">About Us</a>
                        <a href="/committees">Committees</a>
                        <a href="/conference">Conference Details</a>
                    </div>
                    <div class="footer-col">
                        <h4>Contact</h4>
                        <a href="mailto:contact@ratobangala.edu.np"
                            >contact@ratobangala.edu.np</a
                        >
                        <a href="tel:015447618">01-5447618</a>
                        <a href="tel:015447620">01-5447620</a>
                    </div>
                </div>
                <div class="footer-bottom">
                    <p>&copy; 2026 RBSMUN. All rights reserved.</p>
                </div>
            </div>
        </footer>
    </section>

    <style>
        .letter-inner {
            display: block;
        }

        .letter-text-col .letter-text {
            max-width: none;
        }

        @media (max-width: 768px) {
            .letter-sg-photo {
                float: none !important;
                width: 70% !important;
                max-width: 360px;
                margin: 0 auto 2rem !important;
            }
        }
    </style>

    <script>
        let countdownTimerId: any = null;
        let countdownAnimFrame: any = null;
        let countdownObserver: IntersectionObserver | null = null;

        function initCountdown() {
            if (countdownTimerId) clearInterval(countdownTimerId);
            if (countdownAnimFrame) cancelAnimationFrame(countdownAnimFrame);
            if (countdownObserver) {
                countdownObserver.disconnect();
                countdownObserver = null;
            }

            const targetDate = new Date("2026-12-18T00:00:00").getTime();
            const timerContainer = document.getElementById("countdown-timer");

            const elDays = document.getElementById("countdown-days");
            const elHours = document.getElementById("countdown-hours");
            const elMinutes = document.getElementById("countdown-minutes");
            const elSeconds = document.getElementById("countdown-seconds");

            if (!elDays || !elHours || !elMinutes || !elSeconds) return;

            function getTargetValues() {
                const now = new Date().getTime();
                const distance = Math.max(0, targetDate - now);
                return {
                    days: Math.floor(distance / (1000 * 60 * 60 * 24)),
                    hours: Math.floor(
                        (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
                    ),
                    minutes: Math.floor(
                        (distance % (1000 * 60 * 60)) / (1000 * 60),
                    ),
                    seconds: Math.floor((distance % (1000 * 60)) / 1000),
                };
            }

            function updateCountdown() {
                const t = getTargetValues();
                if (elDays) elDays.innerText = t.days.toString();
                if (elHours) elHours.innerText = t.hours.toString();
                if (elMinutes) elMinutes.innerText = t.minutes.toString();
                if (elSeconds) elSeconds.innerText = t.seconds.toString();
            }

            let animated = false;
            function startIntroAnimation() {
                if (animated) return;
                animated = true;

                const duration = 1200; // 1.2s rapid counting animation
                const startTime = performance.now();

                function step(currentTime: number) {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    // Ease out cubic
                    const easeProgress = 1 - Math.pow(1 - progress, 3);

                    const target = getTargetValues();
                    if (elDays)
                        elDays.innerText = Math.floor(
                            target.days * easeProgress,
                        ).toString();
                    if (elHours)
                        elHours.innerText = Math.floor(
                            target.hours * easeProgress,
                        ).toString();
                    if (elMinutes)
                        elMinutes.innerText = Math.floor(
                            target.minutes * easeProgress,
                        ).toString();
                    if (elSeconds)
                        elSeconds.innerText = Math.floor(
                            target.seconds * easeProgress,
                        ).toString();

                    if (progress < 1) {
                        countdownAnimFrame = requestAnimationFrame(step);
                    } else {
                        updateCountdown();
                        countdownTimerId = setInterval(updateCountdown, 1000);
                    }
                }

                // Reset to 0 initially
                if (elDays) elDays.innerText = "0";
                if (elHours) elHours.innerText = "0";
                if (elMinutes) elMinutes.innerText = "0";
                if (elSeconds) elSeconds.innerText = "0";

                countdownAnimFrame = requestAnimationFrame(step);
            }

            if (timerContainer && typeof IntersectionObserver !== "undefined") {
                countdownObserver = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                startIntroAnimation();
                                if (countdownObserver) {
                                    countdownObserver.disconnect();
                                    countdownObserver = null;
                                }
                            }
                        });
                    },
                    { threshold: 0.1 },
                );
                countdownObserver.observe(timerContainer);
            } else {
                startIntroAnimation();
            }
        }

        document.addEventListener("astro:page-load", initCountdown);
        // Fallback for initial load
        if (
            document.readyState === "complete" ||
            document.readyState === "interactive"
        ) {
            initCountdown();
        } else {
            document.addEventListener("DOMContentLoaded", initCountdown);
        }
    </script>
</Layout>
