---
import Layout from '../layouts/Layout.astro';
import WebGLBackground from '../components/WebGLBackground.jsx';
import { REGISTRATION_URL } from '../data/site-config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// TOGGLE: Set to true to display the "Coming Soon" screen.
// Set to false to show the full conference details, bento cards, and itinerary schedule.
const showComingSoon = false;
---

<Layout title="Conference Details — RBSMUN 2026">

    <WebGLBackground client:only="react" />

    <nav class="glass-nav" id="mainNav">
        <div class="nav-inner">
            <a href={`${base}/`} class="nav-logo"><img src={`${base}/images/logo.webp`} alt="RBSMUN Logo"></a>
            <div class="nav-links" id="navLinks">
                <a href={`${base}/`}>Home</a>
                <a href={`${base}/about`}>About Us</a>
                <a href={`${base}/committees`}>Committees</a>
                <a href={`${base}/conference`} class="active">Conference Details</a>
                <a href={`${base}/team`}>Our Team</a>
            </div>
            {REGISTRATION_URL ? (
                <a href={REGISTRATION_URL} target="_blank" class="nav-cta">Register →</a>
            ) : (
                <button class="nav-cta" style="pointer-events: none; opacity: 0.75;" tabindex="-1">Coming Soon</button>
            )}
            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    {showComingSoon ? (
        <div style="display: flex; flex-direction: column; min-height: calc(100vh - 80px);">
            <div style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 4rem 1rem;">
                <div class="glass-card" style="max-width: 600px; width: 100%; text-align: center; padding: clamp(2rem, 8vw, 4rem);" data-anim="morph-in">
                    <div class="card-glow"></div>
                    <p class="section-eyebrow" style="margin-bottom: 1rem;">Itinerary & Logistics</p>
                    <h1 class="section-title" style="margin-bottom: 1.5rem; font-size: clamp(2rem, 5vw, 3rem);">
                        Conference <span class="text-gradient">Details</span>
                    </h1>
                    <p style="font-size: clamp(1.25rem, 3vw, 1.5rem); font-family: var(--font-heading); color: var(--text-primary); font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 1.5rem;">
                        Coming Soon
                    </p>
                    <p style="color: var(--text-secondary); line-height: 1.8; margin-bottom: 2rem;">
                        Scheduling, venue details, and registration information are being finalized by our organizing team and will be released shortly. Stay tuned for updates.
                    </p>
                    <a href={`${base}/`} class="btn btn-glass">Return Home →</a>
                </div>
            </div>
        </div>
    ) : (
        <>
        <section class="page-hero" style={`background-image: url('${base}/images/miscellaneous/PMS01025.webp');`}>
            <div class="hero-bg-overlay"></div>
            <div class="container">
                <h1 class="page-hero-title">Conference Details</h1>
                <p class="page-hero-subtitle">Everything you need to know about logistics, fees, accommodation, and registration.</p>
            </div>
        </section>

        <div class="content-wrapper">

            <!-- ── SCHEDULE ──────────────────────────────────────── -->
            <section class="section section-textured" id="schedule">
                <div class="container">
                    <div class="section-header" data-anim="reveal">
                        <div class="conf-agenda-dynamic">
                            <p class="conf-hero-venue">Rato Bangala School &nbsp;&middot;&nbsp; Patan Dhoka, Lalitpur, Nepal</p>
                            <p class="conf-hero-date">18 – 20 December 2026</p>
                        </div>
                        <h2 class="section-title">Event <span class="text-gradient">Schedule</span></h2>
                    </div>
                    <div class="schedule-scroll-track" id="schedule-stack">
    <div class="glass-card table-wrapper schedule-day-card" style="--stack-index: 1;">
        <h3 class="table-title">Day 1: 19 December Friday</h3>
        <table class="schedule-table">
            <tbody>
                <tr><td class="time-col">By 8:00 AM</td><td class="event-col">Student Organisers in school</td></tr>
                <tr><td class="time-col">By 8:15 AM</td><td class="event-col">All delegates arrive</td></tr>
                <tr><td class="time-col">8:30-9:00 AM</td><td class="event-col">Everyone to be seated</td></tr>
                <tr><td class="time-col">9:00–10:00 AM</td><td class="event-col">Opening Ceremony</td></tr>
                <tr><td class="time-col">10:30 AM–12:30 PM</td><td class="event-col">Committee Session I (2 hours)</td></tr>
                <tr><td class="time-col">12:30-1:30 PM</td><td class="event-col">Lunch</td></tr>
                <tr><td class="time-col">1:30–3:30 PM</td><td class="event-col">Committee Session II (2 hours)</td></tr>
                <tr><td class="time-col">3:30-3:45 PM</td><td class="event-col">Dais Debrief /Dismissal (4 PM)</td></tr>
            </tbody>
        </table>
    </div>
    <div class="glass-card table-wrapper schedule-day-card" style="--stack-index: 2;">
        <h3 class="table-title">Day 2: 20 December Saturday</h3>
        <table class="schedule-table">
            <tbody>
                <tr><td class="time-col">8:00 AM</td><td class="event-col">Student Organizers in school</td></tr>
                <tr><td class="time-col">8:15 AM</td><td class="event-col">Delegates go to their committees</td></tr>
                <tr><td class="time-col">8:30 AM – 11:30 AM</td><td class="event-col">Committee Session III (Group Picture of each committee)</td></tr>
                <tr><td class="time-col">11:30 AM -12:30 PM</td><td class="event-col">Lunch</td></tr>
                <tr><td class="time-col">12:30-1:30 PM</td><td class="event-col">Press Conference</td></tr>
                <tr><td class="time-col">12:30- 2:30 PM</td><td class="event-col">Committee Session IV (2 hours)</td></tr>
                <tr><td class="time-col">2:30-3:00 PM</td><td class="event-col">Tea Break</td></tr>
                <tr><td class="time-col">3:00-4:15 PM</td><td class="event-col">Performance in the Auditorium</td></tr>
                <tr><td class="time-col">By 4:30 PM</td><td class="event-col">Dismissal (everyone leaves)</td></tr>
            </tbody>
        </table>
    </div>
    <div class="glass-card table-wrapper schedule-day-card" style="--stack-index: 3;">
        <h3 class="table-title">Day 3: 21 December Sunday</h3>
        <table class="schedule-table">
            <tbody>
                <tr><td class="time-col">By 7:00 AM</td><td class="event-col">Student Organizers in school</td></tr>
                <tr><td class="time-col">7:15 AM</td><td class="event-col">Delegates go to their committee rooms</td></tr>
                <tr><td class="time-col">7:30–11:30 AM</td><td class="event-col">Committee Session V (4 hours)</td></tr>
                <tr><td class="time-col">11:30 AM -12:15 PM</td><td class="event-col">Lunch</td></tr>
                <tr><td class="time-col">12:15 - 1:45 PM</td><td class="event-col">Committee Session VI (1 hour 30 min.)</td></tr>
                <tr><td class="time-col">1:45 - 2:00 PM</td><td class="event-col">Tea Break</td></tr>
                <tr><td class="time-col">2.00 -2.15 PM</td><td class="event-col">Audience seated in the auditorium</td></tr>
                <tr><td class="time-col">2:30 – 3.45 PM</td><td class="event-col">Closing Ceremony</td></tr>
                <tr><td class="time-col">By 4.00 PM</td><td class="event-col">Dismissal (everyone leaves)</td></tr>
            </tbody>
        </table>
    </div>
</div>

                    <!-- Dress code card sits right below the schedule -->
                    <div class="glass-card conf-bento-card conf-bento-dress" data-anim="tilt-in" style="margin-top: 1.25rem;">
                        <div class="card-glow"></div>
                        <div class="conf-dress-inner">
                            <div class="conf-dress-text">
                                <p class="conf-card-eyebrow">Dress Code</p>
                                <h4 class="conf-card-title">Formal Attire Required</h4>
                                <p class="conf-card-note">Delegates are required to be in formal attire throughout the conference. Men may wear suits and button-down shirts, preferably with blazers and neckties. Women may wear formal dresses, suits, and blouses. Delegates in non-compliant attire will be asked to leave until dressed appropriately.</p>
                            </div>
                            <div class="conf-day-dress">
                                <div class="conf-day-dress-row">
                                    <span class="conf-day-label">Day 1</span>
                                    <span class="conf-day-value">Traditional Attire <span class="conf-optional">(optional)</span></span>
                                </div>
                                <div class="conf-day-dress-row">
                                    <span class="conf-day-label">Day 2</span>
                                    <span class="conf-day-value">Western Formal</span>
                                </div>
                                <div class="conf-day-dress-row">
                                    <span class="conf-day-label">Day 3</span>
                                    <span class="conf-day-value">Western Formal</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ── NATIONAL DELEGATIONS ──────────────────────────── -->
            <section class="section" id="national">
                <div class="container">
                    <div class="section-header" data-anim="reveal">
                        <p class="section-eyebrow">Domestic Participants</p>
                        <h2 class="section-title">National <span class="text-gradient">Delegations</span></h2>
                    </div>

                    <div class="conf-bento-grid conf-bento-national" data-anim="tilt-in">

                        <div class="glass-card conf-bento-card conf-nat-fee">
                            <div class="card-glow"></div>
                            <p class="conf-card-eyebrow">Registration Fee</p>
                            <div class="conf-fee-display">
                                <span class="conf-fee-amount">NPR 7,000</span>
                                <span class="conf-fee-unit">per delegate</span>
                            </div>
                            <p class="conf-card-note">Covers conference fees, meals, and all essential materials during the conference.</p>
                        </div>


                        <div class="glass-card conf-bento-card" style="grid-column: 1 / -1;">
                            <div class="card-glow"></div>
                            <p class="conf-card-eyebrow">Dining &amp; Transportation</p>
                            <p class="conf-card-note" style="margin-bottom: 0.75rem;">Lunch and snacks provided on all 3 conference days at no extra cost.</p>
                            <div class="conf-divider"></div>
                            <p class="conf-card-note" style="margin-top: 0.75rem;">Transportation is <strong>not provided</strong>. Delegates are responsible for managing their own transport to and from the venue on all three days.</p>
                        </div>

                    </div>

                    <!-- Payment -->
                    <div class="glass-card conf-payment-card" data-anim="tilt-in">
                        <div class="card-glow"></div>
                        <p class="conf-card-eyebrow">Payment Details</p>
                        <h4 class="conf-card-title">Bank Transfer</h4>
                        <div class="conf-payment-grid">
                            <div class="conf-payment-row"><span>Account Name</span><strong>Rato Bangala School</strong></div>
                            <div class="conf-payment-row"><span>Account No.</span><strong>01200105200624</strong></div>
                            <div class="conf-payment-row"><span>Bank</span><strong>Everest Bank Limited</strong></div>
                            <div class="conf-payment-row"><span>Branch</span><strong>Pulchowk, Lalitpur, Nepal</strong></div>
                            <div class="conf-payment-row"><span>SWIFT Code</span><strong>EVBLNKA</strong></div>
                        </div>
                        <div class="conf-payment-contact">
                            <p>+977-1-5422614 &nbsp;&middot;&nbsp; +977-1-5442045 &nbsp;&middot;&nbsp; +977-1-5434318</p>
                            <p>Mob: +977-9851034218</p>
                        </div>
                    </div>

                </div>
            </section>

            <!-- ── INTERNATIONAL DELEGATIONS ──────────────────────── -->
            <section class="section section-textured" id="international">
                <div class="container">
                    <div class="section-header" data-anim="reveal">
                        <p class="section-eyebrow">Overseas Participants</p>
                        <h2 class="section-title">International <span class="text-gradient">Delegations</span></h2>
                    </div>

                    <div class="conf-bento-grid" data-anim="tilt-in">

                        <div class="glass-card conf-bento-card conf-bento-hero">
                            <div class="card-glow"></div>
                            <p class="conf-card-eyebrow">Registration Fee</p>
                            <div class="conf-fee-display">
                                <span class="conf-fee-amount">USD 150</span>
                                <span class="conf-fee-unit">per delegate</span>
                            </div>
                            <p class="conf-card-note">Covers conference fees, all meals on conference days, and essential materials.</p>
                        </div>

                        <div class="glass-card conf-bento-card conf-bento-tall">
                            <div class="card-glow"></div>
                            <p class="conf-card-eyebrow">Flights</p>
                            <h4 class="conf-card-title">Travel Window</h4>
                            <div class="conf-timeline">
                                <div class="conf-timeline-item">
                                    <span class="conf-timeline-dot conf-dot-arrive"></span>
                                    <div>
                                        <strong>Arrive by</strong>
                                        <p>17 December 2026</p>
                                    </div>
                                </div>
                                <div class="conf-timeline-item">
                                    <span class="conf-timeline-dot conf-dot-depart"></span>
                                    <div>
                                        <strong>Depart on</strong>
                                        <p>21 December 2026</p>
                                    </div>
                                </div>
                            </div>
                            <p class="conf-card-note" style="margin-top:1rem;">Departures on 20 Dec must be after <strong>8:00 PM NPT</strong>. Email your flight details for accommodation coordination. Book early to avoid price hikes.</p>
                        </div>

                        <div class="glass-card conf-bento-card" style="grid-column: 1 / -1;">
                            <div class="card-glow"></div>
                            <p class="conf-card-eyebrow">Transportation</p>
                            <p class="conf-card-note">Pickup and drop-off provided to/from the venue, airport, and accommodation. All listed hotels are within <strong>1.5 km</strong> of the conference venue.</p>
                        </div>

                        <div class="glass-card conf-bento-card" style="grid-column: 1 / -1;">
                            <div class="card-glow"></div>
                            <p class="conf-card-eyebrow">Dining</p>
                            <p class="conf-card-note">Lunch and snacks provided on all 3 conference days at no extra cost. Accommodation includes breakfast &amp; dinner. Extra meals at hotels: <strong>$20 + 13% VAT</strong> per person.</p>
                        </div>

                    </div>

                    <!-- Hotel Cards -->
                    <div class="conf-hotel-block" data-anim="tilt-in">

                        <div class="glass-card conf-hotel-card">
                            <div class="card-glow"></div>
                            <div class="conf-hotel-header">
                                <p class="conf-card-eyebrow">Option A</p>
                                <h3 class="conf-hotel-name">Hotel Himalaya</h3>
                            </div>
                            <p class="conf-card-eyebrow" style="margin-bottom:0.5rem;">Facilities Included</p>
                            <div class="conf-facilities-grid">
                                <span>Daily Buffet Breakfast at Café Horizon</span>
                                <span>2 Mineral Water bottles/day</span>
                                <span>Swimming Pool Access</span>
                                <span>Tea/Coffee Maker</span>
                                <span>Safe Deposit Locker</span>
                                <span>24-hour Wi-Fi</span>
                                <span>Iron &amp; Ironing Board on request</span>
                            </div>
                            <p class="conf-card-eyebrow" style="margin: 1.5rem 0 0.75rem;">Room Rates (BB Plan)</p>
                            <div style="overflow-x:auto;">
                                <table class="conf-rate-table">
                                    <thead><tr><th>Room</th><th>Single</th><th>Double</th><th>Extra Bed</th></tr></thead>
                                    <tbody>
                                        <tr><td>Deluxe (USD)</td><td>$80++</td><td>$90++</td><td>$40</td></tr>
                                        <tr><td>Deluxe (INR)</td><td>&#8377;7,000</td><td>&#8377;7,500</td><td>&#8377;2,500</td></tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="conf-hotel-notes">
                                <p>Check-in: <strong>14:00</strong> &nbsp;&middot;&nbsp; Check-out: <strong>12:00</strong></p>
                                <p>Taxes: 2% Luxury + 13% VAT</p>
                                <p>Late check-out after 16:00: +50% &nbsp;&middot;&nbsp; After 18:00: +100%</p>
                            </div>
                        </div>

                        <div class="glass-card conf-hotel-card">
                            <div class="card-glow"></div>
                            <div class="conf-hotel-header">
                                <p class="conf-card-eyebrow">Option B</p>
                                <h3 class="conf-hotel-name">Hotel Shangrila Blu</h3>
                            </div>
                            <p class="conf-card-eyebrow" style="margin-bottom:0.5rem;">In-Room Facilities</p>
                            <div class="conf-facilities-grid">
                                <span>1 Mineral Water/person/day</span>
                                <span>Room Service (7 AM – 10 PM)</span>
                                <span>Air Conditioning</span>
                                <span>Tea/Coffee Maker</span>
                                <span>Safe Locker</span>
                                <span>Satellite TV</span>
                                <span>Laundry Service</span>
                                <span>Bathroom Amenities</span>
                            </div>
                            <p class="conf-card-eyebrow" style="margin: 1.5rem 0 0.75rem;">Room Rates (USD)</p>
                            <div style="overflow-x:auto;">
                                <table class="conf-rate-table">
                                    <thead>
                                        <tr><th>Plan</th><th>Queen SNG</th><th>Queen DBL</th><th>Twin SNG</th><th>Twin DBL</th><th>Triple</th><th>SDLX SNG</th><th>SDLX DBL</th></tr>
                                    </thead>
                                    <tbody>
                                        <tr><td>EP</td><td>$41</td><td>$44</td><td>$41</td><td>$44</td><td>$55</td><td>$55</td><td>$59</td></tr>
                                        <tr><td>BB</td><td>$44</td><td>$48</td><td>$44</td><td>$48</td><td>$59</td><td>$59</td><td>$66</td></tr>
                                        <tr><td>MAP</td><td>$54</td><td>$68</td><td>$54</td><td>$68</td><td>$89</td><td>$69</td><td>$86</td></tr>
                                        <tr><td>AP</td><td>$64</td><td>$89</td><td>$64</td><td>$89</td><td>$99</td><td>$79</td><td>$106</td></tr>
                                    </tbody>
                                </table>
                            </div>
                            <!-- Meal Plan Legend moved inside Shangrila Blu card -->
                            <div class="conf-legend-inline">
                                <p class="conf-card-eyebrow" style="margin: 1.25rem 0 0.6rem;">Meal Plan Legend</p>
                                <div class="conf-legend-grid">
                                    <div><strong>EP</strong><span>Room only</span></div>
                                    <div><strong>BB</strong><span>Bed &amp; Breakfast</span></div>
                                    <div><strong>MAP</strong><span>Breakfast + Dinner</span></div>
                                    <div><strong>AP</strong><span>All meals</span></div>
                                </div>
                            </div>
                            <div class="conf-hotel-notes">
                                <p>Check-in: <strong>14:00</strong> &nbsp;&middot;&nbsp; Check-out: <strong>12:00</strong></p>
                                <p>Taxes: 13% VAT &nbsp;&middot;&nbsp; Extra Bed: $10</p>
                                <p>Late check-out charged at full EP plan rate</p>
                            </div>
                        </div>

                    </div>

                    <!-- Payment -->
                    <div class="glass-card conf-payment-card" data-anim="tilt-in">
                        <div class="card-glow"></div>
                        <p class="conf-card-eyebrow">Payment Details</p>
                        <h4 class="conf-card-title">Bank Transfer</h4>
                        <div class="conf-payment-grid">
                            <div class="conf-payment-row"><span>Account Name</span><strong>Rato Bangala School</strong></div>
                            <div class="conf-payment-row"><span>Account No.</span><strong>01200105200624</strong></div>
                            <div class="conf-payment-row"><span>Bank</span><strong>Everest Bank Limited</strong></div>
                            <div class="conf-payment-row"><span>Branch</span><strong>Pulchowk, Lalitpur, Nepal</strong></div>
                            <div class="conf-payment-row"><span>SWIFT Code</span><strong>EVBLNKA</strong></div>
                        </div>
                        <div class="conf-payment-contact">
                            <p>contact@ratobangala.edu.np</p>
                            <p>+977-1-5422614 &nbsp;&middot;&nbsp; +977-1-5442045 &nbsp;&middot;&nbsp; +977-1-5434318</p>
                            <p>Mob: +977-9851034218</p>
                        </div>
                    </div>

                </div>
            </section>

        </div>
        </>
    )}

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4 class="footer-logo">RBS<span class="logo-accent">MUN</span></h4>
                </div>
                <div class="footer-col">
                    <h4>Navigate</h4>
                    <a href="/">Home</a>
                    <a href="/about">About Us</a>
                    <a href="/committees">Committees</a>
                    <a href="/conference">Conference Details</a>
                </div>
                <div class="footer-col">
                    <h4>Contact</h4>
                    <a href="mailto:contact@ratobangala.edu.np">contact@ratobangala.edu.np</a>
                    <a href="tel:015447618">01-5447618</a>
                    <a href="tel:015447620">01-5447620</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 RBSMUN. All rights reserved.</p>
            </div>
        </div>
    </footer>

</Layout>

<style>
/* ── Bento grid ───────────────────────────────────────── */
.conf-bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 2rem;
}

.conf-venue-line {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
}

.conf-bento-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.conf-bento-hero {
    grid-column: span 1;
    background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 100%);
}

.conf-bento-tall {
    grid-column: span 1;
}

/* National section: 2-column grid with fee spanning full width */
.conf-bento-national {
    grid-template-columns: 1fr 1fr;
}

.conf-nat-fee {
    grid-column: span 2;
    background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 100%);
}

/* Divider inside combined card */
.conf-divider {
    height: 1px;
    background: rgba(255,255,255,0.08);
    flex-shrink: 0;
}

/* ── Card typography ────────────────────────────────────── */
.conf-card-eyebrow {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
    margin: 0;
}

.conf-card-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0.25rem 0 0;
}

.conf-card-note {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
}

/* ── Fee display ─────────────────────────────────────────── */
.conf-fee-display {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0.5rem 0;
}

.conf-fee-amount {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    background: linear-gradient(135deg, #ffffff, #a0a0c0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
