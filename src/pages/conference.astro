---
import Layout from '../layouts/Layout.astro';
import WebGLBackground from '../components/WebGLBackground.jsx';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// TOGGLE: Set to true to display the "Coming Soon" screen.
// Set to false to show the full conference details, bento cards, and itinerary schedule.
const showComingSoon = true;
---

<Layout title="Conference Details — RBSMUN 2026">

    <WebGLBackground client:only="react" />

    <nav class="glass-nav" id="mainNav">
        <div class="nav-inner">
            <a href={`${base}/`} class="nav-logo"><img src={`${base}/images/logo.webp`} alt="RBSMUN Logo"></a>
            <div class="nav-links" id="navLinks">
                <a href={`${base}/`}>Home</a>
                <a href={`${base}/about`}>About Us</a>
                <a href={`${base}/committees`}>Committees</a>
                <a href={`${base}/conference`} class="active">Conference Details</a>
                <a href={`${base}/team`}>Our Team</a>
            </div>
            <a href="https://docs.google.com/forms/d/e/1FAIpQLScHRl-Q3-XBSMNHwiufUyGBYGU-MBBVO2-GGSOJL0atyxPcKg/viewform"
                target="_blank" class="nav-cta">Register →</a>
            <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    {showComingSoon ? (
        <div class="content-wrapper" style="min-height: calc(100vh - 80px - 300px); display: flex; align-items: center; justify-content: center; padding: 4rem 1rem;">
            <div class="container" style="display: flex; justify-content: center; width: 100%;">
                <div class="glass-card" style="max-width: 600px; width: 100%; text-align: center; padding: clamp(2rem, 8vw, 4rem);" data-anim="morph-in">
                    <div class="card-glow"></div>
                    <p class="section-eyebrow" style="margin-bottom: 1rem;">Itinerary & Logistics</p>
                    <h1 class="section-title" style="margin-bottom: 1.5rem; font-size: clamp(2rem, 5vw, 3rem);">
                        Conference <span class="text-gradient">Details</span>
                    </h1>
                    <p style="font-size: clamp(1.25rem, 3vw, 1.5rem); font-family: var(--font-heading); color: var(--text-primary); font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 1.5rem;">
                        Coming Soon
                    </p>
                    <p style="color: var(--text-secondary); line-height: 1.8; margin-bottom: 2rem;">
                        Scheduling, venue details, and registration information are being finalized by our organizing team and will be released shortly. Stay tuned for updates.
                    </p>
                    <a href={`${base}/`} class="btn btn-glass">Return Home →</a>
                </div>
            </div>
        </div>
    ) : (
        <section class="page-hero" style={`background-image: url('${base}/images/miscellaneous/PMS01025.webp');`}>
            <div class="hero-bg-overlay"></div>
            <div class="container">
                <h1 class="page-hero-title">Conference Details</h1>
                <p class="page-hero-subtitle">Everything you need to know about logistics, scheduling, and registration.</p>
            </div>
        </section>

        <div class="content-wrapper">

            <section class="section">
                <div class="container">
                    <div class="info-grid bento-grid">
                        <div class="glass-card info-card bento-card-main" data-anim="tilt-in">
                            <div class="card-glow"></div>
                            <h3>Venue</h3>
                            <p>Rato Bangala School<br>Patan Dhoka, Lalitpur, Nepal</p>
                            <p style="margin-top: 1rem;">The conference will take place across our academic blocks,
                                featuring state-of-the-art halls for the General Assembly and Plenary sessions.</p>
                        </div>
                        <div class="glass-card info-card bento-card-secondary" data-anim="tilt-in">
                            <div class="card-glow"></div>
                            <h3>Dress Code</h3>
                            <p><strong>Western Business Attire (WBA)</strong></p>
                            <ul>
                                <li>Suits, ties, blazers, and formal trousers.</li>
                                <li>Formal skirts/dresses (knee-length or longer).</li>
                                <li>National attire is deeply encouraged on the final day of the conference.</li>
                            </ul>
                        </div>
                        <div class="glass-card info-card bento-card-secondary" data-anim="tilt-in">
                            <div class="card-glow"></div>
                            <h3>Registration</h3>
                            <p>Registration is currently open for both individual delegates and school delegations.</p>
                            <ul style="margin-top: 0.5rem; margin-bottom: 1rem;">
                                <li><strong>Early Bird Deadline:</strong> To be announced</li>
                                <li><strong>Regular Deadline:</strong> To be announced</li>
                            </ul>
                            <a href="https://docs.google.com/forms/d/e/1FAIpQLScHRl-Q3-XBSMNHwiufUyGBYGU-MBBVO2-GGSOJL0atyxPcKg/viewform"
                                target="_blank" class="btn btn-glass"
                                style="font-size: 0.75rem; padding: 0.5rem 1rem;">Register Here →</a>
                        </div>
                    </div>
                </div>
            </section>

            <section class="section section-textured" id="schedule">
                <div class="container">
                    <div class="section-header" data-anim="reveal">
                        <p class="section-eyebrow">Itinerary</p>
                        <h2 class="section-title">Event <span class="text-gradient">Schedule</span></h2>
                    </div>

                    <div class="schedule-scroll-track" id="schedule-stack">

                        <div class="glass-card table-wrapper schedule-day-card" style="--stack-index: 1;">
                            <h3 class="table-title">Day 1: Friday</h3>
                            <table class="schedule-table">
                                <tbody>
                                    <tr>
                                        <td class="time-col">08:00 AM</td>
                                        <td class="event-col">Registration & Breakfast</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">09:30 AM</td>
                                        <td class="event-col">Opening Ceremony</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">11:00 AM</td>
                                        <td class="event-col">Committee Session I</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">01:00 PM</td>
                                        <td class="event-col">Lunch Break</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">02:00 PM</td>
                                        <td class="event-col">Committee Session II</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">04:30 PM</td>
                                        <td class="event-col">End of Day 1</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="glass-card table-wrapper schedule-day-card" style="--stack-index: 2;">
                            <h3 class="table-title">Day 2: Saturday</h3>
                            <table class="schedule-table">
                                <tbody>
                                    <tr>
                                        <td class="time-col">08:30 AM</td>
                                        <td class="event-col">Arrival & Tea</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">09:00 AM</td>
                                        <td class="event-col">Committee Session III</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">12:30 PM</td>
                                        <td class="event-col">Lunch Break</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">01:30 PM</td>
                                        <td class="event-col">Committee Session IV</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">04:00 PM</td>
                                        <td class="event-col">High Tea & Networking</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">05:00 PM</td>
                                        <td class="event-col">Delegate Dance / Social Event</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="glass-card table-wrapper schedule-day-card" style="--stack-index: 3;">
                            <h3 class="table-title">Day 3: Sunday</h3>
                            <table class="schedule-table">
                                <tbody>
                                    <tr>
                                        <td class="time-col">08:30 AM</td>
                                        <td class="event-col">Arrival</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">09:00 AM</td>
                                        <td class="event-col">Committee Session V (Voting Block)</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">11:30 AM</td>
                                        <td class="event-col">Final Plenary Session</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">01:00 PM</td>
                                        <td class="event-col">Lunch</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">02:00 PM</td>
                                        <td class="event-col">Closing Ceremony & Awards</td>
                                    </tr>
                                    <tr>
                                        <td class="time-col">04:00 PM</td>
                                        <td class="event-col">End of Conference</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </section>

        </div>
    )}

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4 class="footer-logo">RBS<span class="logo-accent">MUN</span></h4>
                </div>
                <div class="footer-col">
                    <h4>Navigate</h4>
                    <a href="/">Home</a>
                    <a href="/about">About Us</a>
                    <a href="/committees">Committees</a>
                    <a href="/conference">Conference Details</a>
                </div>
                <div class="footer-col">
                    <h4>Contact</h4>
                    <a href="mailto:contact@ratobangala.edu.np">contact@ratobangala.edu.np</a>
                    <a href="tel:015447618">01-5447618</a>
                    <a href="tel:015447620">01-5447620</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 RBSMUN. All rights reserved.</p>
            </div>
        </div>
    </footer>

</Layout>
