</style>

<script>
    const handleScroll = () => {
        if (window.scrollY > 50) {
            document.body.classList.add("is-scrolled");
        } else {
            document.body.classList.remove("is-scrolled");
        }
    };
    window.addEventListener("scroll", handleScroll, { passive: true });
    document.addEventListener("astro:page-load", () => {
        handleScroll();
        window.addEventListener("scroll", handleScroll, { passive: true });
    });
</script>
